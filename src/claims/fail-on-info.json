{
  "id": "fail-on.info",
  "version": 1,
  "title": "no confirmed finding at or above info",
  "needs": { "kinds": ["finding"] },
  "view": { "kinds": ["finding", "collection"] },
  "shape": "set",
  "quantifier": "none",
  "from": "finding",
  "where": "item.severity in [\"info\", \"low\", \"medium\", \"high\", \"critical\"]",
  "holds": "item.state == \"confirmed\"",
  "covered": "ctx.collections.size() > 0 && ctx.collections.all(by, ctx.collections[by].status == \"complete\")",
  "vacuous": "pass",
  "examples": [
    {
      "name": "a confirmed info finding",
      "expect": "fail",
      "facts": [
        { "kind": "finding", "by": "example", "body": { "severity": "info", "state": "confirmed" } },
        { "kind": "collection", "by": "example", "body": { "status": "complete" } }
      ]
    },
    {
      "name": "an unconfirmed info finding",
      "expect": "pass",
      "facts": [
        { "kind": "finding", "by": "example", "body": { "severity": "info", "state": "unconfirmed" } },
        { "kind": "collection", "by": "example", "body": { "status": "complete" } }
      ]
    },
    {
      "name": "a collector that did not finish",
      "expect": "not_checked",
      "facts": [
        { "kind": "finding", "by": "example", "body": { "severity": "info", "state": "unconfirmed" } },
        { "kind": "collection", "by": "example", "body": { "status": "failed" } }
      ]
    }
  ]
}
